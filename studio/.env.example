# Site Studio (Cloudflare Pages build variables). See README.md.
# The website's API, ending in /api/v1 (the site proxies it, so this always works).
VITE_API_BASE_URL=https://www.recruitkr.com/api/v1
# The public website the preview frame loads.
VITE_SITE_URL=https://www.recruitkr.com
# Google Picker ("From Google Drive"). Optional: without them the button is hidden.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
